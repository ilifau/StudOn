exc#:#exc_require_authorship_statement_desc#:#Requires confirmation of a declaration of originality before submission
exc#:#exc_result_available_after#:#Results available from
exc#:#exc_result_time#:#Result date
exc#:#exc_result_time_info#:#If this is selected, the evaluation and tutors feedback can only be viewed from this date. No automatic notifications are sent beforehand.
exc#:#exc_result_time_not_for_peer_feedback#:#The result date does not count for peer feedback. Please use the settings there for ending the evaluation period.
