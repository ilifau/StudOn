exc#:#exc_plag_effective_zero#:#(Effectively 0)
exc#:#exc_plag_none#:#No
exc#:#exc_plag_original_mark#:#, original grade/points:
exc#:#exc_plag_see_comment#:#, see comment
exc#:#exc_plag_state#:#Status
exc#:#exc_plag_suspicion#:#Suspicion
exc#:#exc_plag_suspicion_info#:#Suspected plagiarism
exc#:#exc_plag_visible_info#:#If plagiarism is suspected, the status and comment are only shown to tutors. Participants are informed if plagiarism is detected. The effective status is then failed and the grade/points empty or 0.
exc#:#exc_plagiarism#:#Plagiarism
exc#:#exc_preliminary_info#:#Here you can see a provisional evaluation from the exercise units that have already been announced.
exc#:#exc_preliminary_mark#:#Provisional grade/points
exc#:#exc_preliminary_status#:#Provisional status
exc#:#exc_require_authorship_statement#:#Declaration of originality
