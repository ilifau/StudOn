exc#:#exc_accept_authorship_statement#:#Confirm declaration of originality
exc#:#exc_ass_type_test_object#:#Test object
exc#:#exc_ass_type_test_object_info#:#Test object whose status and points are automatically taken over as the evaluation for this unit. This evaluation is updated after each test run within the deadline for submission. Depending on the test settings, either the best or the last test run is evaluated. Please ensure that the test settings match the schedule for this unit.
exc#:#exc_ass_type_test_open#:#Open test
exc#:#exc_ass_type_test_open_info#:#You submit this exercise unit by taking a test. The result is automatically entered as the result of this exercise unit.
exc#:#exc_ass_type_test_open_label#:#Submission
exc#:#exc_ass_type_test_open_no_team#:#First you have to form a team or be accepted onto a team in order to complete the test for this exercise unit.
exc#:#exc_ass_type_test_sync#:#Synchronize test results
exc#:#exc_ass_type_test_sync_info#:#The available results for all participants will be re-transferred. In the case of teams, the most recent test result will be taken for all members.
exc#:#exc_ass_type_test_sync_label#:#For administrators
exc#:#exc_ass_type_test_synced#:#The test results have been synchronized.
exc#:#exc_authorship_statement#:#Declaration of originality
exc#:#exc_authorship_statement_accepted_at#:#Declaration of originality confirmed: %s
exc#:#exc_calc_all_calculated#:#All totals have been re-calculated.
exc#:#exc_calc_calculate#:#Calculate
exc#:#exc_calc_confirm_all#:#Would you like to re-calculate the totals for everyone who has participated in the exercise?
exc#:#exc_calc_mark_force_zero#:#Set missing values to 0
exc#:#exc_calc_mark_force_zero_info#:#Submissions or exercise units that are not evaluated before the result date should be integrated into the evaluation with 0 points.
exc#:#exc_calc_mark_function#:#Grades/points calculation
exc#:#exc_calc_mark_function_average#:#Average
exc#:#exc_calc_mark_function_average_info#:#An average grade is calculated on the basis of the selected exercise units.
exc#:#exc_calc_mark_function_sum#:#Total
exc#:#exc_calc_mark_function_sum_info#:#The points from all selected exercise units are added together.
exc#:#exc_calc_mark_select#:#Selection of exercise units
exc#:#exc_calc_mark_select_count#:#Number
exc#:#exc_calc_mark_select_count_info#:#You must include at least the obligatory exercise units. These values always count.
exc#:#exc_calc_mark_select_count_message#:#Please select at least the obligatory exercise units (%s).
exc#:#exc_calc_mark_select_highest#:#The highest values
exc#:#exc_calc_mark_select_info#:#At least the obligatory units must be evaluated.<br /> Only the grades/points are taken into account, not whether they have been passed or not. If not enough results are available, the total score will remain empty.
exc#:#exc_calc_mark_select_lowest#:#The lowest values
exc#:#exc_calc_mark_select_mandatory#:#All obligatory exercise units
exc#:#exc_calc_mark_select_marked#:#All exercise units with grades/points
exc#:#exc_calc_mark_select_number#:#Determined quantity
exc#:#exc_calc_mark_select_order#:#Selection
exc#:#exc_calc_settings#:#Settings for calculating the total score
exc#:#exc_calc_settings_update_status#:#The total score for all test participants will be re-calculated when these settings are saved.
exc#:#exc_calc_status#:#Status calculation
exc#:#exc_calc_status_compare#:#Passed if
exc#:#exc_calc_status_compare_absolute#:#Absolute value
exc#:#exc_calc_status_compare_absolute_info#:#The calculated grades/points are compared directly with the threshold value.
exc#:#exc_calc_status_compare_base#:#Matching basis
exc#:#exc_calc_status_compare_higher#:#greater than threshold value
exc#:#exc_calc_status_compare_higher_equal#:#greater than or the same as the threshold value
exc#:#exc_calc_status_compare_info#:#You have to state a threshold value in order to complete the calculation. It can also be given as a decimal figure. Comma and point will be treated the same.
exc#:#exc_calc_status_compare_lower#:#smaller than threshold value
exc#:#exc_calc_status_compare_lower_equal#:#smaller than or the same as the threshold value
exc#:#exc_calc_status_compare_percent#:#Percentage
exc#:#exc_calc_status_compare_percent_info#:#The calculated grades/points are compared in percent to the total possible number of points in all exercise units. This is only possible if a maximum number of points is given for all exercise units and the total is calculated when calculating points.
exc#:#exc_calc_status_compare_value#:#Threshold
exc#:#exc_calc_status_default#:#Default value
exc#:#exc_calc_status_default_info#:#If the total score is empty due to a lack of individual results, the status is set to this value.
exc#:#exc_calc_status_info#:#The Pass status is then calculated automatically on the basis of the points determined.
exc#:#exc_calculate_overall_results#:#Calculate total results
exc#:#exc_comment_for_learner_info_nosend#:#No notification is sent. After the result date is reached, feedback is published in the exercise unit view.
exc#:#exc_create_single_teams#:#Create individual teams
exc#:#exc_create_single_teams_confirmation#:#Would you like to create individual teams for the following users? This then allows you to evaluate them, but they are no longer available for joining teams with others.
exc#:#exc_create_single_teams_empty#:#No participants without a team were found.
exc#:#exc_create_single_teams_finished#:#The individual teams have been created.
exc#:#exc_feedback_notification#:#Notification if feedback is given
exc#:#exc_feedback_notification_info#:#If new feedback is given, the participants in the exercise are sent e-mail notification. This setting applies to all participants.
exc#:#exc_file_suffixes#:#Permitted file extensions
exc#:#exc_file_suffixes_case_checked#:#Case sensitive
exc#:#exc_file_suffixes_case_ignored#:#Not case sensitive
